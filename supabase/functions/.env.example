# Server-only staging secrets. Never copy into Vite or commit real values.
AUTOMATION_SCHEDULER_SECRET=REPLACE_WITH_SERVER_ONLY_RANDOM_SECRET
EAZILY_FINANCIAL_PROVIDERS_ENABLED=false
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are platform-provided.
# Do not configure Cashfree credentials or delivery providers for this task.

# Send SMS hook (MSG91 phone OTP). Installed with `supabase secrets set`.
# The hook secret is issued by Supabase under Authentication > Hooks. Keep the
# "v1," prefix exactly as Supabase shows it.
SEND_SMS_HOOK_SECRETS=v1,whsec_REPLACE_WITH_BASE64_SECRET
# MSG91 authkey from control.msg91.com and the approved transactional template id.
MSG91_AUTHKEY=REPLACE_WITH_MSG91_AUTHKEY
MSG91_TEMPLATE_ID=REPLACE_WITH_MSG91_FLOW_TEMPLATE_ID
# Template variable that carries the code. Match the placeholder in the template.
MSG91_OTP_VARIABLE=VAR1
# Fails closed. Keep false until the template is approved and a test message passes.
EAZILY_SMS_PROVIDER_ENABLED=false

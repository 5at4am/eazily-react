# Copy to .env.local and fill in your own values.
# Both values are safe to ship to the browser: row level security in Postgres
# is what protects your data. Never put the service_role / secret key in here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
VITE_AUTH_EMAIL_OTP_LENGTH=8

# Sign-in supports Google and email OTP. Mobile authentication is disabled.
# Match the hosted Email OTP length above. Never ship server secrets.
# See docs/GOOGLE-EMAIL-AUTH-SETUP.md.

VITE_PARTNER_DEMO=false
